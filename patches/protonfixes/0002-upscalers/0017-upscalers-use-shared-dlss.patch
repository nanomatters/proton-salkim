+        ini.write_text(original)
+        env = {'DXVK_NVAPI_DRS_SETTINGS': 'custom=123'}
+        with mock.patch.object(dlss, 'prepare') as prepare, mock.patch.object(progress, 'Progress'):
+            optiscaler_dlss_setup(env, self.compat, self.prefix)
