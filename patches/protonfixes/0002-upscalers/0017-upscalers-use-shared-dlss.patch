+    def test_optiscaler_dlss_uses_shared_paths_without_copying(self):
+        from upscalers import dlss, progress
+        shared = self.root / 'shared DLSS'
+        shared.mkdir()
+        ini = self.destination / 'OptiScaler.ini'
+        ini.write_text('[Libraries]\n; keep comment\nNvngxDlssPath=auto\nNvngxFeaturePath=auto\n')
+        with mock.patch.object(dlss, 'prepare', return_value=shared) as prepare, \
+                mock.patch.object(progress, 'Progress'):
+            optiscaler_dlss_setup({'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix)
+        expected = r'\\?\unix' + str(shared).replace('/', '\\')
+        parser = nightly.configparser.ConfigParser(interpolation=None)
+        parser.read(ini)
+        self.assertEqual(parser['Libraries']['NvngxDlssPath'], expected)
+        self.assertEqual(parser['Libraries']['NvngxFeaturePath'], expected)
+        self.assertIn('; keep comment', ini.read_text())
+        self.assertFalse(list(self.destination.rglob('nvngx_dlss*.dll')))
+        prepare.assert_called_once()
+
+    def test_streamline_setup_uses_configured_shared_dlss_without_prefix_files(self):
+        from upscalers import dlss, progress
+        shared = self.root / 'shared DLSS'
+        shared.mkdir()
+        for name in upscalers.streamline.DLSS:
+            (shared / name).write_bytes(b'shared runtime')
+        ini = self.destination / 'OptiScaler.ini'
+        ini.write_bytes(INI)
+        with mock.patch.object(dlss, 'prepare', return_value=shared), mock.patch.object(progress, 'Progress'):
+            optiscaler_dlss_setup({'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix)
+        archive = self.root / 'streamline.zip'
+        with zipfile.ZipFile(archive, 'w') as output:
+            for name in upscalers.streamline.REQUIRED:
+                output.writestr('bin/x64/' + name, b'plugin')
+            output.writestr('license.txt', b'licence')
+        item = {'version': 'v2.14.16', 'download_url': 'https://example.invalid/fixture.zip', 'sha256': 'a' * 64}
+        records = {}
+        with mock.patch.object(upscalers.streamline, 'resolve', return_value=item), \
+                mock.patch.object(nightly, 'verified_download', return_value=archive):
+            streamline_setup(self.cache, self.destination, records, records.update)
+        self.assertTrue(upscalers.streamline.current(item, self.destination, records))
+        parser = nightly.configparser.ConfigParser(interpolation=None)
+        parser.read(ini)
+        self.assertEqual(parser['Libraries']['NvngxFeaturePath'],
+                         r'\\?\unix' + str(shared).replace('/', '\\'))
+        self.assertFalse(list(self.destination.rglob('nvngx_dlss*.dll')))
+        self.assertTrue(all((shared / name).read_bytes() == b'shared runtime'
+                            for name in upscalers.streamline.DLSS))
+
+    def test_optiscaler_dlss_preserves_explicit_paths_and_presets(self):
