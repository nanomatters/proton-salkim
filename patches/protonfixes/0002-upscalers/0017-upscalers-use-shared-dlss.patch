+    def test_shared_dlss_migration_removes_only_owned_unchanged_aliases(self):
+        from upscalers import dlss, progress
+        self.installed()
+        self.dependency_files('opti_files', {'OptiScaler/nvngx_dlss.dll': b'old',
+                                           'OptiScaler/nvngx_dlssd.dll': b'custom',
+                                           'OptiScaler/nvngx_dlssg.dll': b'keep regular file'})
+        alias = self.destination / 'OptiScaler/nvngx_dlss.dll'
+        alias.unlink()
+        alias.symlink_to('../nvngx_dlss.dll')
+        modified = self.destination / 'OptiScaler/nvngx_dlssd.dll'
+        modified.unlink()
+        modified.symlink_to('../user.dll')
+        tracking = self.compat / 'upscaler_files'
+        records = json.loads(tracking.read_text())
+        for name in ('nvngx_dlss.dll', 'nvngx_dlssd.dll', 'nvngx_dlssg.dll'):
+            records['opti_files'][f'{nightly.ROOT}/OptiScaler/{name}']['md5_hash'] = None
+        tracking.write_text(json.dumps(records))
+        with mock.patch.object(dlss, 'prepare', return_value=self.root / 'shared'), \
+                mock.patch.object(progress, 'Progress'):
+            optiscaler_dlss_setup({'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix)
+        self.assertFalse(alias.is_symlink())
+        self.assertTrue(modified.is_symlink())
+        self.assertEqual((self.destination / 'OptiScaler/nvngx_dlssg.dll').read_bytes(), b'keep regular file')
+        self.assertNotIn(f'{nightly.ROOT}/OptiScaler/nvngx_dlss.dll', json.loads(tracking.read_text())['opti_files'])
+
