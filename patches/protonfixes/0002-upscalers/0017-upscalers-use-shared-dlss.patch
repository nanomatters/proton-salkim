+            ini.write_text(original)
+            with mock.patch.object(dlss, 'prepare') as prepare:
+                optiscaler_dlss_setup({'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix)
+            self.assertEqual(ini.read_text(), original)
+            prepare.assert_not_called()
+
