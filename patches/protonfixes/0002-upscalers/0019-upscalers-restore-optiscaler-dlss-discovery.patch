+    def test_dlss_probe_refreshes_owned_file_and_rolls_back_failed_update(self):
+        from upscalers import dlss
+        ini = self.destination / 'OptiScaler.ini'
+        ini.write_bytes(INI)
+        name = 'nvngx_dlss.dll'
+        self.dependency_files('dlss_files', {name: b'old standalone SR', 'nvngx_dlssd.dll': b'original RR'})
+        target = self.destination / name
+        old, new = self.root / '1', self.root / '2'
+        for directory in (old, new):
+            directory.mkdir()
+            (directory / name).write_bytes(directory.name.encode())
+        with mock.patch.object(dlss, 'prepare', return_value=old):
+            optiscaler_dlss_setup({}, self.compat, self.prefix)
+            self.assertEqual(target.read_bytes(), b'1')
+            before = self.snapshot()
+            with mock.patch.object(upscalers.shutil, 'copyfile', side_effect=AssertionError) as copy:
+                optiscaler_dlss_setup({}, self.compat, self.prefix)
+                copy.assert_not_called()
+        with mock.patch.object(dlss, 'prepare', return_value=new):
+            with mock.patch.object(upscalers, '__set_tracked_items', side_effect=OSError('disk full')):
+                optiscaler_dlss_setup({}, self.compat, self.prefix)
+            self.assertEqual(self.snapshot(), before)
+            optiscaler_dlss_setup({}, self.compat, self.prefix)
+        self.assertEqual(target.read_bytes(), b'2')
+        self.assertEqual((self.destination / 'nvngx_dlssd.dll').read_bytes(), b'original RR')
