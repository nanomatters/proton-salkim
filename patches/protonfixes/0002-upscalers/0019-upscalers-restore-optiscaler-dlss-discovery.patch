+def __optiscaler_dlss_probe(compat_dir, destination, records, source, *, pinned=False):
+    """CheckUpscalerFiles searches beside the proxy for a signed SR DLL."""
+    name = 'nvngx_dlss.dll'
+    key = f'{nightly.ROOT}/{name}'
+    target = destination / name
+    record = records.get(key, {})
+    owned = ()
+    if os.path.lexists(target):
+        # An older Proton may already own this file through its DLSS downloader.
+        if target.is_symlink() or not target.is_file() or not record.get('md5_hash'):
+            return
+        # A verified release directory is immutable. A modified prefix file
+        # must also be left alone, so neither requires a rewrite on this launch.
+        if pinned and record.get('opti_source') == str(source):
+            return
+        current = nightly.file_hash(target, 'md5')
+        if current != record['md5_hash'].lower():
+            return
+        owned = (name,)
+    elif any(path.name.lower() == name for path in destination.iterdir()):
+        return  # Wine resolves filenames case-insensitively.
+    if owned and current == nightly.file_hash(source, 'md5') and record.get('opti_source') == str(source):
+        return
+    with tempfile.TemporaryDirectory(prefix='.dlss-stage-', dir=destination.parent) as tmp:
+        stage = Path(tmp)
+        shutil.copyfile(source, stage / name)
+        updated = {**records, key: {'version': source.parent.name, 'opti_source': str(source),
+                                    'md5_hash': nightly.file_hash(stage / name, 'md5')}}
+        nightly.install(stage, destination, owned, (name,),
+                        lambda: __set_tracked_items(compat_dir, 'dlss_files', updated))
+
