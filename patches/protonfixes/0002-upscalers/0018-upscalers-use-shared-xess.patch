+    def test_stable_xess_uses_one_shared_directory_without_prefix_copies(self):
+        from upscalers import xess, progress
+        shared = self.root / 'shared XeSS'
+        shared.mkdir()
+        ini = self.destination / 'OptiScaler.ini'
+        ini.write_text('[Libraries]\n; keep comment\nXeSSPath=auto\n')
+        with mock.patch.object(xess, 'prepare', return_value=shared) as prepare, \
+                mock.patch.object(progress, 'Progress'):
+            optiscaler_xess_setup({'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix)
+        text = ini.read_text()
+        for key, name in {'XeSSPath': 'libxess.dll', 'XeSSDx11Path': 'libxess_dx11.dll',
+                          'XeFGPath': 'libxess_fg.dll', 'XeLLPath': 'libxell.dll'}.items():
+            self.assertIn(key + '=' + r'\\?\unix' + str(shared / name).replace('/', '\\'), text)
+        self.assertIn('; keep comment', text)
+        self.assertFalse(list(self.destination.glob('libxe*.dll')))
+        prepare.assert_called_once()
+
+    def test_stable_xess_keeps_custom_paths_as_a_set(self):
+        from upscalers import xess
+        ini = self.destination / 'OptiScaler.ini'
+        for key in ('XeSSPath', 'XeSSDx11Path', 'XeFGPath', 'XeLLPath'):
+            original = '[Libraries]\n' + key + '=C:\\custom\\library.dll\n'
+            ini.write_text(original)
+            with mock.patch.object(xess, 'prepare') as prepare:
+                optiscaler_xess_setup({'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix)
+            prepare.assert_not_called()
+            self.assertEqual(ini.read_text(), original)
+
+    def test_stable_xess_updates_managed_paths_and_preserves_old_release(self):
+        from upscalers import xess, progress
+        old = self.root / 'proton/components/xess/old'
+        new = self.root / 'proton/components/xess/new'
+        old.mkdir(parents=True)
+        ini = self.destination / 'OptiScaler.ini'
+        ini.write_text('[Libraries]\nXeSSPath=' + r'\\?\unix' + str(old / 'libxess.dll').replace('/', '\\') + '\n')
+        with mock.patch.object(xess, 'prepare', return_value=new), mock.patch.object(progress, 'Progress'):
+            optiscaler_xess_setup({'XDG_DATA_HOME': str(self.root), 'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix)
+        self.assertIn(r'\xess\new\libxess.dll', ini.read_text())
+        self.assertNotIn(r'\xess\old\libxess.dll', ini.read_text())
+        self.assertTrue(old.is_dir())
+
+    def test_nightly_restores_managed_xess_paths_to_bundled_without_download(self):
+        from upscalers import xess
+        self.bundled_dependencies()
+        old = self.root / 'proton/components/xess/old'
+        ini = self.destination / 'OptiScaler.ini'
+        ini.write_bytes(nightly.update_ini(ini.read_bytes(), {
+            ('Libraries', 'XeSSPath'): r'\\?\unix' + str(old / 'libxess.dll').replace('/', '\\'),
+            ('Libraries', 'XeLLPath'): r'C:\custom\libxell.dll',
+        }))
+        with mock.patch.object(xess, 'prepare') as prepare:
+            optiscaler_xess_setup({'XDG_DATA_HOME': str(self.root), 'PROTON_UPSCALER_UPGRADE': '1'}, self.compat, self.prefix, bundled=True)
+        self.assertIn('XeSSPath=auto', ini.read_text())
+        self.assertIn(r'XeLLPath=C:\custom\libxell.dll', ini.read_text())
+        prepare.assert_not_called()
+        self.assertEqual((self.destination / 'OptiScaler/libxess.dll').read_bytes(), b'private XeSS')
+
