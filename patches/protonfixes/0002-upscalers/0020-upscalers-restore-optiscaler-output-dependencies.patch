+    def test_stable_configures_output_libraries_with_game_upgrades_off(self):
+        from upscalers import ffx, xess
+        ini = self.destination / 'OptiScaler.ini'
+        sdk = self.root / 'SDK'
+        intel = self.root / 'XeSS'
+        defaults = r'OptiDllPath = c:\windows\system32\umu'
+        libraries = {
+            'FfxDx12Path': sdk / 'amd_fidelityfx_dx12.dll',
+            'FfxVkPath': sdk / 'amd_fidelityfx_vk.dll',
+            'XeSSPath': intel / 'libxess.dll',
+            'XeSSDx11Path': intel / 'libxess_dx11.dll',
+            'XeFGPath': intel / 'libxess_fg.dll',
+            'XeLLPath': intel / 'libxell.dll',
+        }
+        self.sdk_setup.side_effect = optiscaler_ffx_setup
+        self.xess_setup.side_effect = optiscaler_xess_setup
+        for settings in ({}, {'PROTON_UPSCALER_UPGRADE': '0'}):
+            with self.subTest(settings=settings):
+                ini.write_text('[Libraries]\n' + defaults + '\n' +
+                               ''.join(key + '=auto\n' for key in libraries))
+                with mock.patch.object(ffx, 'prepare', return_value=sdk) as prepare_sdk, \
+                        mock.patch.object(xess, 'prepare', return_value=intel) as prepare_xess:
+                    env, _ = self.run_upscalers(env={'PROTON_USE_OPTISCALER': '1', **settings})
+                text = ini.read_text()
+                self.assertIn(defaults, text)
+                for key, path in libraries.items():
+                    self.assertIn(key + '=' + r'\\?\unix' + str(path).replace('/', '\\'), text)
+                prepare_sdk.assert_called_once()
+                prepare_xess.assert_called_once()
+                self.assertEqual(env, {'PROTON_USE_OPTISCALER': '1',
+                                       'WINE_OPTISCALER_NAME': 'dxgi.dll', **settings})
+
