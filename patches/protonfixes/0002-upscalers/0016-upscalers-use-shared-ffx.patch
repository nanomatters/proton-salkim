+    def test_disabled_component_upgrades_allow_explicit_provider(self):
+        from upscalers import progress
+        ini = self.destination / 'OptiScaler.ini'
+        manual = self.root / 'manual'
+        manual.mkdir()
+        for name, component, setup, key, other, filename in self.component_upgrades():
+            for bundled in ((False, True) if name != 'dlss' else (False,)):
+                with self.subTest(component=name, bundled=bundled):
+                    ini.write_text('[Libraries]\n' + key + '=auto\n')
+                    env = {'PROTON_UPSCALER_UPGRADE': '0',
+                           'WINE_' + name.upper() + '_PROVIDER': str(manual)}
+                    kwargs = {'bundled': bundled} if name != 'dlss' else {}
+                    with mock.patch.object(component, 'prepare', return_value=manual) as prepare, \
+                            mock.patch.object(progress, 'Progress'):
+                        setup(env, self.compat, self.prefix, **kwargs)
+                    prepare.assert_called_once()
+                    self.assertEqual(prepare.call_args.args[0], env)
+                    path = manual / filename if filename else manual
+                    self.assertIn(key + '=' + r'\\?\unix' + str(path).replace('/', '\\'), ini.read_text())
