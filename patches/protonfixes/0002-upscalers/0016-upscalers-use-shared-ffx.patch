+    def test_failed_automatic_component_upgrade_resets_managed_paths(self):
+        from upscalers.storage import ComponentError
+        ini = self.destination / 'OptiScaler.ini'
+        for name, component, setup, key, other, filename in self.component_upgrades():
+            with self.subTest(component=name):
+                old = self.root / 'proton/components' / name / 'old'
+                path = old / filename if filename else old
+                value = r'\\?\unix' + str(path).replace('/', '\\')
+                original = '[Libraries]\n; keep comment\n' + key + '=' + value + '\nUnrelated=C:\\custom\\runtime.dll\n'
+                ini.write_text(original)
+                env = {'XDG_DATA_HOME': str(self.root), 'PROTON_UPSCALER_UPGRADE': '1'}
+                with mock.patch.object(component, 'prepare', side_effect=ComponentError('no verified cache')):
+                    setup(env, self.compat, self.prefix)
+                self.assertIn(key + '=auto', ini.read_text())
+                self.assertIn('Unrelated=C:\\custom\\runtime.dll', ini.read_text())
+                self.assertIn('; keep comment', ini.read_text())
+                ini.write_text(original)
+                env['WINE_' + name.upper() + '_PROVIDER'] = '/manual/runtime'
+                with mock.patch.object(component, 'prepare', side_effect=ComponentError('invalid manual path')):
+                    setup(env, self.compat, self.prefix)
+                self.assertEqual(ini.read_text(), original)
+
