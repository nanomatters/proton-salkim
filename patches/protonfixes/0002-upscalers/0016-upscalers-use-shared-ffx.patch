+    def test_verified_cached_component_is_selected_when_update_fails(self):
+        from copy import deepcopy
+        from upscalers import storage
+        ini = self.destination / 'OptiScaler.ini'
+        for name, component, setup, key, other, filename in self.component_upgrades():
+            with self.subTest(component=name):
+                manifest = deepcopy(component.catalog())
+                manifest['version'] = '1.0'
+                for library, item in manifest['files'].items():
+                    payload = library.encode()
+                    item.update(size=len(payload), sha256=hashlib.sha256(payload).hexdigest())
+                def download(item, target, *args, **kwargs):
+                    Path(target).write_bytes(Path(target).name.encode())
+                env = {'XDG_DATA_HOME': str(self.root), 'PROTON_UPSCALER_UPGRADE': '1'}
+                with mock.patch.object(component, 'catalog', return_value=manifest), \
+                        mock.patch.object(storage, 'download_file', side_effect=download):
+                    old = component.prepare(env)
+                manifest['version'] = '2.0'
+                ini.write_text('[Libraries]\n' + key + '=auto\n')
+                with mock.patch.object(component, 'catalog', return_value=manifest), \
+                        mock.patch.object(storage, 'download_file', side_effect=OSError('offline')):
+                    setup(env, self.compat, self.prefix)
+                expected = old / filename if filename else old
+                self.assertIn(key + '=' + r'\\?\unix' + str(expected).replace('/', '\\'), ini.read_text())
+                self.assertNotIn('2.0', ini.read_text())
+
+    def test_default_leaves_fresh_and_custom_ini_untouched(self):
+        ini = self.destination / 'OptiScaler.ini'
+        for name, component, setup, key, other, filename in self.component_upgrades():
+            for value in ('auto', r'C:\custom\runtime.dll'):
+                with self.subTest(component=name, value=value):
+                    original = '[Libraries]\n; keep comment\n' + key + '=' + value + '\n'
+                    ini.write_text(original)
+                    with mock.patch.object(component, 'prepare') as prepare:
+                        setup({}, self.compat, self.prefix)
+                    prepare.assert_not_called()
+                    self.assertEqual(ini.read_text(), original)
+
+    def test_disabled_component_upgrades_reset_only_managed_paths(self):
+        ini = self.destination / 'OptiScaler.ini'
+        for name, component, setup, key, other, filename in self.component_upgrades():
+            with self.subTest(component=name):
+                old = self.root / 'proton/components' / name / 'old'
+                old.mkdir(parents=True)
+                path = old / filename if filename else old
+                if filename:
+                    path.write_bytes(b'old runtime')
+                ini.write_text('[Libraries]\n; keep comment\n' + key + '=' + r'\\?\unix' +
+                               str(path).replace('/', '\\') + '\n' + other + '=C:\\custom\\runtime.dll\n')
+                env = {'PROTON_UPSCALER_UPGRADE': '0', 'XDG_DATA_HOME': str(self.root)}
+                with mock.patch.object(component, 'prepare') as prepare:
+                    setup(env, self.compat, self.prefix)
+                prepare.assert_not_called()
+                text = ini.read_text()
+                self.assertIn(key + '=auto', text)
+                self.assertIn(other + '=C:\\custom\\runtime.dll', text)
+                self.assertIn('; keep comment', text)
+                self.assertTrue(path.exists())
