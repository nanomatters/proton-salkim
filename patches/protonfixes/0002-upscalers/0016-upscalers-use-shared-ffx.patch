+def __setup_optiscaler_ffx(env, compat_dir, prefix_dir, *, bundled=False):
+    """Stable OptiScaler releases use the shared SDK instead of prefix copies."""
+    try:
+        from upscalers import ffx, progress
+        from upscalers.storage import data_home
+
+        with open(Path(compat_dir) / '.optiscaler.lock', 'a') as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            ini = Path(prefix_dir) / nightly.ROOT / 'OptiScaler.ini'
+            original = ini.read_bytes()
+            parser = configparser.ConfigParser(interpolation=None)
+            parser.read_string(original.decode('utf-8-sig'))
+            libraries = parser['Libraries'] if parser.has_section('Libraries') else {}
+            options = {'FfxDx12Path': 'amd_fidelityfx_dx12.dll', 'FfxVkPath': 'amd_fidelityfx_vk.dll'}
+            shared = r'\\?\unix' + str(data_home(env) / 'proton/components/ffx').replace('/', '\\') + '\\'
+            managed = {key for key, name in options.items()
+                       if libraries.get(key, '').startswith(shared)
