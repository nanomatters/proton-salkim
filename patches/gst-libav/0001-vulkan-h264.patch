+static void
+gst_ffmpegviddec_try_vulkan (GstFFMpegVidDec * ffmpegdec, const AVCodec * codec)
+{
+  AVCodecContext *context = ffmpegdec->context;
+  const AVCodecHWConfig *config;
+  gint i, ret;
+
+  if (codec->id != AV_CODEC_ID_H264 || context->lowres
+      || (context->flags2 & AV_CODEC_FLAG2_CHUNKS))
+    return;
+
+  for (i = 0; (config = avcodec_get_hw_config (codec, i)); i++) {
+    if (config->device_type == AV_HWDEVICE_TYPE_VULKAN
+        && (config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX))
+      break;
+  }
+  if (!config)
+    return;
+
+  /* FFmpeg checks the video queue and stream profile during format
+   * selection, then retries in software if hardware setup fails. */
+  ret = av_hwdevice_ctx_create (&context->hw_device_ctx,
+      AV_HWDEVICE_TYPE_VULKAN, NULL, NULL, 0);
+  if (ret < 0)
+    GST_INFO_OBJECT (ffmpegdec, "Vulkan device unavailable: %s",
+        av_err2str (ret));
+}
+
